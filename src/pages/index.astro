---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";

const allProducts = await getCollection("products");
const products = allProducts
  .map(p => p.data)
  .sort((a, b) => a.priceCents - b.priceCents);

const mechanismMap: Record<string, string> = {
  "recalibrate-tea": "Eight plants — ginkgo, gotu kola, brahmi, L-theanine, moringa. Traditional use associates the blend with cerebral blood flow and unhurried attention.",
  "brain-chocolate": "Theobromine from 85% cacao (10× lower adenosine affinity than caffeine), 100 mg L-theanine per square (Nobre 2008, alpha-wave activity), lion's mane for NGF. No caffeine, no cortisol spike.",
  "earthsheet": "A 7% silver-fibre grid woven into organic cotton transfers earth electrons through a 98 kΩ safety resistor. Mechanism is multimeter-measurable; physiological magnitude studied (Chevalier, Ghaly, Sokal) but contested.",
  "broccoli-sprout-powder": "Three-day sprouts carry up to 100× the glucoraphanin of mature florets (Fahey 1997). Active myrosinase converts it to sulforaphane on contact — NRF2 activation; HDAC inhibition observed in human studies (Atwell 2015).",
};

const timeOfDayMap: Record<string, string> = {
  "recalibrate-tea": "Day",
  "brain-chocolate": "Mid-day",
  "earthsheet": "Night",
  "broccoli-sprout-powder": "Daily",
};
---

<Base title="Terraliving — Tools for a clear, grounded nervous system">
  <Header slot="header" />

  <!-- 1. Hero -->
  <section class="relative min-h-screen min-h-[600px] flex flex-col justify-end overflow-hidden">
    <img
      src="/images/home-hero.svg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <!-- subtle gradient to anchor the bottom text -->
    <div class="absolute inset-0 bg-gradient-to-t from-clay/60 via-clay/10 to-transparent pointer-events-none"></div>
    <div class="relative z-10 pb-24 px-12 max-w-4xl">
      <p class="eyebrow text-terracotta">FOUNDING 20 · PRE-ORDERS OPEN</p>
      <h1
        class="font-display font-light text-ink mt-6 leading-[1.05] tracking-tight"
        style="font-size: clamp(56px, 7vw, 96px);"
      >
        Tools for a clear, grounded nervous system.
      </h1>
      <p class="text-lg text-stone mt-6 max-w-xl" style="font-family: var(--font-body);">
        Small daily rituals from a Sunshine Coast kitchen. The first 20 jars ship 2–3 weeks after the batch is funded.
      </p>
      <a
        href="/shop"
        class="bg-terracotta text-clay px-6 py-3 text-sm font-medium uppercase tracking-wider mt-8 inline-block hover:opacity-90"
      >
        Reserve yours
      </a>
    </div>
  </section>

  <!-- 2. The Tools -->
  <section class="max-w-6xl mx-auto px-6 pt-16">
    <h2 class="font-display text-[3rem] text-ink text-center">The tools.</h2>
    {products.map((product, i) => (
      <ProductCard
        product={product}
        imagePosition={i % 2 === 0 ? "left" : "right"}
      />
    ))}
  </section>

  <!-- 4. The Mechanism strip -->
  <section class="bg-bone py-24 mt-20">
    <p class="eyebrow text-center">The mechanism</p>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 max-w-6xl mx-auto px-6 mt-10">
      {products.map(product => (
        <div class="py-6 px-4">
          <p class="eyebrow text-sage">{timeOfDayMap[product.slug] ?? ""}{product.comingSoon ? " · Coming soon" : ""}</p>
          <h3 class="font-display text-2xl mt-3 text-ink">{product.name}</h3>
          <p class="mt-3 text-sm text-stone leading-relaxed">
            {mechanismMap[product.slug] ?? ""}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. From Sunshine Coast -->
  <section class="grid grid-cols-1 md:grid-cols-2 max-w-6xl mx-auto px-6 py-32 gap-12 items-center">
    <div>
      <img
        src="/images/founder-portrait.svg"
        alt="The founder in a sunlit Queensland kitchen"
        class="aspect-[4/5] object-cover w-full bg-bone"
      />
    </div>
    <div>
      <p class="eyebrow">From the founder</p>
      <h2 class="font-display text-4xl text-ink mt-4 leading-tight">Made on the Sunshine Coast.</h2>
      <p class="mt-6 text-ink leading-relaxed" style="font-size: 17px; font-family: var(--font-body);">
        These products came out of a personal search — years of reading research, working alongside herbalists, and running quiet experiments on my own body. I grew up between Colombia and Australia, in two traditions that both took plants and land seriously. What I found was that the nervous system doesn't need complexity. It needs the right touchpoints across the day: a clear-headed morning, a reset at night, and a slow long-arc practice that compounds over months. I found the right partners — a textile mill, a mushroom grower, a network of herbalists — all within reach of the Sunshine Coast.
      </p>
      <a
        href="/about"
        class="mt-6 inline-block text-sage underline underline-offset-4 hover:text-terracotta"
        style="font-family: var(--font-body); font-size: 0.9rem;"
      >
        Read the story →
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
